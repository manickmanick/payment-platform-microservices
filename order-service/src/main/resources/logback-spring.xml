
<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <springProperty
            scope="context"
            name="serviceName"
            source="spring.application.name"
            defaultValue="order-service"/>

    <property name="LOG_DIR"
              value="${user.dir}/order-service/logs"/>

    <!-- JSON Console Appender: Local and Docker -->
    <appender name="JSON_CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <threadName/>
                <message/>
                <mdc/>
                <arguments/>
                <stackTrace/>

                <pattern>
                    <pattern>
                        {
                        "service": "${serviceName}",
                        "environment": "${APP_ENV:-local}"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <!-- File Appender: Only when docker profile is NOT active -->
    <springProfile name="!docker">

        <appender name="JSON_FILE"
                  class="ch.qos.logback.core.rolling.RollingFileAppender">

            <file>${LOG_DIR}/${serviceName}.json</file>

            <rollingPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

                <fileNamePattern>
                    ${LOG_DIR}/archive/${serviceName}.%d{yyyy-MM-dd}.%i.json.gz
                </fileNamePattern>

                <maxFileSize>10MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>

            </rollingPolicy>

            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp/>
                    <logLevel/>
                    <loggerName/>
                    <threadName/>
                    <message/>
                    <mdc/>
                    <arguments/>
                    <stackTrace/>

                    <pattern>
                        <pattern>
                            {
                            "service": "${serviceName}",
                            "environment": "${APP_ENV:-local}"
                            }
                        </pattern>
                    </pattern>
                </providers>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>

    </springProfile>

    <!-- Docker: Console only -->
    <springProfile name="docker">

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>

    </springProfile>

</configuration>
