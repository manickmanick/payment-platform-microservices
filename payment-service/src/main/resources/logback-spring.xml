<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- Read application name from Spring configuration -->
    <springProperty
            scope="context"
            name="serviceName"
            source="spring.application.name"
            defaultValue="payment-service"/>

    <!-- JSON Console Appender -->
    <appender name="JSON_CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">

            <providers>

                <timestamp/>

                <logLevel/>

                <loggerName/>

                <threadName/>

                <message/>

                <mdc/>

                <arguments/>

                <stackTrace/>

                <!-- Additional application metadata -->
                <pattern>
                    <pattern>
                        {
                        "service": "${serviceName}",
                        "environment": "${APP_ENV:-local}"
                        }
                    </pattern>
                </pattern>

            </providers>

        </encoder>

    </appender>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>

</configuration>
